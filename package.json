{
  "name": "dijital-kutuphane-portali",
  "version": "1.0.0",
  "description": "Dijital Kütüphane Portalı - Admin, Üye ve Kütüphaneci girişleri",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm run build",
    "seed": "node server/seed-data.js",
    "seed:force": "node server/seed-data.js --force"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
